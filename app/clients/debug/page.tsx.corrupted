'use client';

import { useState } from 'react';
import { Button } from '@/components/ui/button';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/ca                  <div className="space-y-3">
                    {supabaseResults?.clients?.map((client: ClientData) => (
                      <div key={String(client.id || '')} className="p-3 bg-green-50 border border-green-200 rounded-lg">
                        <div className="font-medium text-green-900">{client.name || 'Sans nom'}</div>
                        <div className="text-xs text-green-700 space-y-1 mt-2">
                          <div><strong>ID Supabase:</strong> {String(client.id || '')}</div>
                          <div><strong>ID ExtraBat:</strong> {String(client.extrabat_id || '')}</div>port { Input } from '@/components/ui/input';
import { Badge } from '@/components/ui/badge';
import { Search, Database, Users, AlertCircle } from 'lucide-react';
import ProtectedRoute from '@/components/ProtectedRoute';

interface ClientData {
  id?: string | number;
  extrabat_id?: string | number;
  cli_id?: string | number;
  name?: string;
  email?: string;
  cli_email?: string;
  phone?: string;
  cli_tel?: string;
  cli_mobile?: string;
  city?: string;
  cli_ville?: string;
  created_at?: string;
  updated_at?: string;
  [key: string]: string | number | undefined;
}

interface SearchResults {
  clients?: ClientData[];
  error?: string;
}

export default function ClientsDebugPage() {
  const [searchTerm, setSearchTerm] = useState('');
  const [extrabatResults, setExtrabatResults] = useState<SearchResults | null>(null);
  const [supabaseResults, setSupabaseResults] = useState<SearchResults | null>(null);
  const [loading, setLoading] = useState(false);

  const handleSearch = async () => {
    if (!searchTerm.trim()) return;

    setLoading(true);
    try {
      // Recherche dans ExtraBat
      const extrabatResponse = await fetch('/api/debug/search-extrabat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ searchTerm })
      });
      const extrabatData = await extrabatResponse.json();
      setExtrabatResults(extrabatData);

      // Recherche dans Supabase
      const supabaseResponse = await fetch('/api/debug/search-supabase', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ searchTerm })
      });
      const supabaseData = await supabaseResponse.json();
      setSupabaseResults(supabaseData);
    } catch (error) {
      console.error('Erreur de recherche:', error);
    } finally {
      setLoading(false);
    }
  };

  return (
    <ProtectedRoute>
      <div className="container mx-auto p-6">
        <div className="mb-6">
          <h1 className="text-3xl font-bold tracking-tight mb-2">
            🔍 Debug Clients - Comparaison ExtraBat vs Supabase
          </h1>
          <p className="text-muted-foreground">
            Comparez les données entre ExtraBat et Supabase pour trouver les différences
          </p>
        </div>

        {/* Recherche */}
        <Card className="mb-6">
          <CardHeader>
            <CardTitle>Rechercher un client</CardTitle>
          </CardHeader>
          <CardContent>
            <div className="flex gap-2">
              <div className="relative flex-1">
                <Search className="absolute left-3 top-1/2 transform -translate-y-1/2 h-4 w-4 text-gray-400" />
                <Input
                  type="text"
                  placeholder="Nom du client ou ID ExtraBat..."
                  value={searchTerm}
                  onChange={(e) => setSearchTerm(e.target.value)}
                  onKeyDown={(e) => e.key === 'Enter' && handleSearch()}
                  className="pl-10"
                />
              </div>
              <Button onClick={handleSearch} disabled={loading || !searchTerm.trim()}>
                {loading ? 'Recherche...' : 'Rechercher'}
              </Button>
            </div>
          </CardContent>
        </Card>

        {/* Résultats */}
        {(extrabatResults || supabaseResults) && (
          <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
            {/* Résultats ExtraBat */}
            <Card>
              <CardHeader>
                <CardTitle className="flex items-center gap-2">
                  <Database className="h-5 w-5 text-blue-600" />
                  ExtraBat
                  {extrabatResults?.clients && (
                    <Badge variant="secondary">
                      {extrabatResults.clients.length} trouvé{extrabatResults.clients.length > 1 ? 's' : ''}
                    </Badge>
                  )}
                </CardTitle>
              </CardHeader>
              <CardContent>
                {extrabatResults?.error ? (
                  <div className="text-red-600 flex items-center gap-2">
                    <AlertCircle className="h-4 w-4" />
                    {extrabatResults.error}
                  </div>
                ) : extrabatResults?.clients?.length === 0 ? (
                  <p className="text-gray-500">Aucun client trouvé dans ExtraBat</p>
                ) : (
                  <div className="space-y-3">
                    {(extrabatResults?.clients as ClientData[] | undefined)?.map((client, index: number) => (
                      <div key={index} className="p-3 bg-blue-50 border border-blue-200 rounded-lg">
                        <div className="font-medium text-blue-900">{client.name || 'Sans nom'}</div>
                        <div className="text-xs text-blue-700 space-y-1 mt-2">
                          <div><strong>ID ExtraBat:</strong> {String(client.extrabat_id || client.cli_id || client.id || '')}</div>
                          {client.email && <div><strong>Email:</strong> {client.email || client.cli_email}</div>}
                          {client.phone && <div><strong>Tél:</strong> {client.phone || client.cli_tel || client.cli_mobile}</div>}
                          {client.city && <div><strong>Ville:</strong> {client.city || client.cli_ville}</div>}
                        </div>
                        <details className="mt-2">
                          <summary className="text-xs text-blue-600 cursor-pointer">Voir données brutes</summary>
                          <pre className="text-xs bg-white p-2 rounded mt-2 overflow-auto">
                            {JSON.stringify(client, null, 2)}
                          </pre>
                        </details>
                      </div>
                    ))}
                  </div>
                )}
              </CardContent>
            </Card>

            {/* Résultats Supabase */}
            <Card>
              <CardHeader>
                <CardTitle className="flex items-center gap-2">
                  <Users className="h-5 w-5 text-green-600" />
                  Supabase
                  {supabaseResults?.clients && (
                    <Badge variant="secondary">
                      {supabaseResults.clients.length} trouvé{supabaseResults.clients.length > 1 ? 's' : ''}
                    </Badge>
                  )}
                </CardTitle>
              </CardHeader>
              <CardContent>
                {supabaseResults?.error ? (
                  <div className="text-red-600 flex items-center gap-2">
                    <AlertCircle className="h-4 w-4" />
                    {supabaseResults.error}
                  </div>
                ) : supabaseResults?.clients?.length === 0 ? (
                  <p className="text-gray-500">Aucun client trouvé dans Supabase</p>
                ) : (
                  <div className="space-y-3">
                    {supabaseResults?.clients?.map((client: Record<string, unknown>) => (
                      <div key={client.id} className="p-3 bg-green-50 border border-green-200 rounded-lg">
                        <div className="font-medium text-green-900">{client.name}</div>
                        <div className="text-xs text-green-700 space-y-1 mt-2">
                          <div><strong>ID Supabase:</strong> {client.id}</div>
                          <div><strong>ID ExtraBat:</strong> {client.extrabat_id}</div>
                          {client.email && <div><strong>Email:</strong> {client.email}</div>}
                          {client.phone && <div><strong>Tél:</strong> {client.phone}</div>}
                          {client.city && <div><strong>Ville:</strong> {client.city}</div>}
                          {client.created_at && <div><strong>Créé le:</strong> {new Date(client.created_at).toLocaleString('fr-FR')}</div>}
                          {client.updated_at && <div><strong>MAJ le:</strong> {new Date(client.updated_at).toLocaleString('fr-FR')}</div>}
                        </div>
                        <details className="mt-2">
                          <summary className="text-xs text-green-600 cursor-pointer">Voir données brutes</summary>
                          <pre className="text-xs bg-white p-2 rounded mt-2 overflow-auto">
                            {JSON.stringify(client, null, 2)}
                          </pre>
                        </details>
                      </div>
                    ))}
                  </div>
                )}
              </CardContent>
            </Card>
          </div>
        )}

        {/* Analyse des différences */}
        {extrabatResults?.clients?.length > 0 && supabaseResults?.clients?.length === 0 && (
          <Card className="mt-6 border-orange-200 bg-orange-50">
            <CardHeader>
              <CardTitle className="flex items-center gap-2 text-orange-900">
                <AlertCircle className="h-5 w-5" />
                Client trouvé dans ExtraBat mais pas dans Supabase
              </CardTitle>
            </CardHeader>
            <CardContent className="text-orange-800">
              <p className="mb-2">Ce client existe dans ExtraBat mais n&apos;a pas été synchronisé dans Supabase.</p>
              <p className="text-sm">
                <strong>Actions possibles:</strong>
              </p>
              <ul className="list-disc list-inside text-sm mt-2 space-y-1">
                <li>Lancez une synchronisation depuis le bouton &quot;Sync ExtraBat&quot;</li>
                <li>Vérifiez que l&apos;ID ExtraBat du client est correct</li>
                <li>Consultez les logs de la dernière synchronisation</li>
              </ul>
            </CardContent>
          </Card>
        )}
      </div>
    </ProtectedRoute>
  );
}
